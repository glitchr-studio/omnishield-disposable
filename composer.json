{
    "name": "omniguard/disposable",
    "type": "library",
    "description": "Omniguard Disposable: is this e-mail's domain a disposable one - the free disposable-email-domains list (CC0) shipped in the package, an allow list and a deny list of the site's, subdomains included; no call while a request runs, a command to refresh the list.",
    "keywords": [
        "email",
        "disposable-email",
        "temporary-email",
        "blocklist",
        "antispam",
        "omniguard"
    ],
    "homepage": "https://github.com/glitchr-studio/omniguard-disposable",
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "Marco Meyer",
            "email": "marco.meyer@glitchr.io"
        }
    ],
    "require": {
        "php": ">=8.2",
        "glitchr/omniguard": "^1.0@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "suggest": {
        "symfony/http-client": "Refreshing the list through the application's HTTP client (bin/omniguard-disposable works without it)"
    },
    "bin": [
        "bin/omniguard-disposable"
    ],
    "autoload": {
        "psr-4": {
            "Omniguard\\Disposable\\": ""
        },
        "exclude-from-classmap": [
            "/Tests/",
            "/bin/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Omniguard\\Disposable\\Tests\\": "Tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
